# Serve a página de manutenção (/manutencao) no lugar de qualquer rota do site.
MAINTENANCE_MODE=false

# Qual copy a página usa: "reconstrucao" (padrão, site que já existia) ou
# "construcao" (site novo, ainda no ar pela primeira vez).
# Lida no build — mudar o valor exige um novo deploy.
MAINTENANCE_VARIANT=reconstrucao

# Destino das inscrições do "avise quando o site entrar no ar".
# Sem esta variável o formulário responde 503 e a página aponta para o e-mail de contato.
WAITLIST_WEBHOOK_URL=

# Origem do devbutter_backend (FastAPI) que o /admin consome. Server-only —
# nunca é exposta ao client, o token de sessão fica em cookie httpOnly.
# Padrão local: uvicorn rodando em devbutter_backend na porta 8002.
API_BASE_URL=http://localhost:8002

# Origem pública do devbutter_backend (mesmo serviço acima), usada pelo
# socket.io-client do chat do portal (NewQuoteModal) — precisa ser alcançável
# direto do navegador, e listada em cors_allowed_origins do devbutter_backend.
# Em local dev é a mesma porta do API_BASE_URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8002

# Domínio compartilhado do cookie de sessão do portal (db_portal_at/db_portal_rt).
# Vazio = cookie host-only, correto em local dev (frontend e backend, mesmo
# "localhost", portas diferentes — cookies ignoram porta). Em produção, se
# frontend e devbutter_backend ficam em subdomínios diferentes (ex:
# app.devbutter.com / api.devbutter.com), defina o domínio pai compartilhado
# (ex: .devbutter.com) para que o cookie viaje no handshake do Socket.IO.
PORTAL_COOKIE_DOMAIN=
