# Serve a página de manutenção (/manutencao) no lugar de qualquer rota do site.
MAINTENANCE_MODE=false

# Qual copy a página usa: "reconstrucao" (padrão, site que já existia) ou
# "construcao" (site novo, ainda no ar pela primeira vez).
# Lida no build — mudar o valor exige um novo deploy.
MAINTENANCE_VARIANT=reconstrucao

# Destino das inscrições do "avise quando o site entrar no ar".
# Sem esta variável o formulário responde 503 e a página aponta para o e-mail de contato.
WAITLIST_WEBHOOK_URL=

# Origem do devbutter_backend (FastAPI) que o /admin consome. Server-only —
# nunca é exposta ao client, o token de sessão fica em cookie httpOnly.
# Padrão local: uvicorn rodando em devbutter_backend na porta 8002.
API_BASE_URL=http://localhost:8002
