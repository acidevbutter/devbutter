# devbutter_frontend -- Dokploy image.
#
# Dokploy "Application":  Build Type = Dockerfile, Docker File = docker/Dockerfile.dokploy,
#                         Docker Context Path = ., container port 3000.
#   Build-time Arguments: NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SOCKET_URL (inlined
#                         into the client bundle by `next build`, so they must be
#                         build args -- setting them only as runtime env does nothing).
#   Environment:          API_BASE_URL, PORTAL_COOKIE_DOMAIN, MAINTENANCE_*, ... (runtime).
# Dokploy "Compose":      docker-compose.dokploy.yml.
#
# Standard Next.js image: 3-stage build, DOCKER=1 triggers
# `output: "standalone"` (next.config.ts) so runtime ships only the traced
# node_modules subset instead of the full yarn install. Mirrors the non-root
# uid/gid 10001 "app" + WORKDIR /app convention used by every backend service
# (devbutter_backend, butter_relay, butter_blob, butter_mind, asaas_payment).
# Tests already gate merges in .github/workflows/frontend-quality.yml, so they
# are not repeated here -- keeps the deploy build fast and independent of any
# network access the e2e suite would otherwise need inside the build sandbox.

FROM node:24-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

FROM node:24-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare yarn@1.22.22 --activate

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG DOCKER=1
ENV DOCKER=$DOCKER

# Public, non-secret values baked into the client bundle at build time.
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_SOCKET_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN yarn build

FROM node:24-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

# tini as PID 1: forwards Swarm's SIGTERM to node and reaps zombies.
RUN apk add --no-cache curl tini \
    && addgroup --system --gid 10001 app \
    && adduser --system --uid 10001 --ingroup app app

COPY --from=builder --chown=app:app /app/public ./public
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static

USER app

EXPOSE 3000

# Liveness only. 127.0.0.1, not localhost (which resolves to ::1 while the
# server listens on IPv4 -- DVB-348/DVB-458). Any HTTP answer counts as alive,
# so maintenance mode or redirects never mark the container unhealthy.
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -s -o /dev/null http://127.0.0.1:3000/ || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]
